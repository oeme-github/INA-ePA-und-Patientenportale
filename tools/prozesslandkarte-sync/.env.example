# Vorlage – Datei kopieren und mit echten Werten füllen: cp .env.example .env
#
# Verbindungsdaten zur Postgres-Instanz der open-starcore-Bereitstellung, die
# die Workgroup "ak-patientenportale" hostet (siehe
# https://github.com/oeme-github/open-starcore). Für die aktuelle
# Heimnetz-Instanz: DB_HOST=inabox.lan, POSTGRES_PASSWORD aus deren
# supabase/.env übernehmen.

DB_HOST=inabox.lan
DB_PORT=5435
POSTGRES_PASSWORD=
